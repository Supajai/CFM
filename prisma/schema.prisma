// prisma/schema.prisma
// ระบบบริหารจัดการและแจ้งซ่อมประจำอาคารแผนกวิชาช่างเทคนิคคอมพิวเตอร์ (Single Department Scope)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String          @id @default(cuid())
  name             String
  email            String          @unique
  role             Role            @default(USER)
  phone            String?
  studentId        String?
  technicianCode   String?
  position         String?
  avatar           String?
  department       String?         @default("แผนกวิชาช่างเทคนิคคอมพิวเตอร์")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  password         String          @default("$2a$10$iI02Qk8uA1xR9v.8qVnFaeJ7j2W0d4bC3F0XJ0O8V5v4V1v4V1v4V")
  classLevel       String?
  major            String?
  specialty        String?
  managedBuildings Building[]      @relation("BuildingAdmin")
  reportedTickets  Ticket[]        @relation("ReporterTickets")
  assignedTickets  Ticket[]        @relation("TechnicianTickets")
  ticketHistories  TicketHistory[] @relation("ChangedByUser")

  @@index([role])
  @@index([email])
}

model Ticket {
  id               String          @id @default(cuid())
  ticketNumber     String          @unique
  incidentCode     String?
  title            String
  description      String          @db.Text
  category         Category        @default(OTHER)
  building         String          @default("อาคารแผนกวิชาช่างเทคนิคคอมพิวเตอร์")
  floor            Int             @default(1)
  room             String
  roomName         String          @default("")
  specificPoint    String?         // เช่น โต๊ะคอมเครื่องที่ 12
  specificLocation String?
  latitude         Float?
  longitude        Float?
  gpsAccuracy      Float?
  isUrgent         Boolean         @default(false)
  priority         Priority        @default(NORMAL)
  slaTargetMinutes Int?            @default(15)

  // ภาพถ่ายก่อนและหลังซ่อม และรายละเอียดการแก้ไข (Proof of Work)
  beforeImageUrl   String?         @db.Text
  afterImageUrl    String?         @db.Text
  resolutionDetail String?         @db.Text

  status           TicketStatus    @default(PENDING)
  currentStep      Int             @default(1)
  stepNote         String?
  cancelReason     String?         @db.Text
  holdReason       String?         @db.Text
  estimatedCompletionAt DateTime?
  etaMinutes       Int?
  partsOrdered     Boolean         @default(false)
  rating           Int?
  feedback         String?         @db.Text
  resolvedAt       DateTime?
  closedAt         DateTime?
  reporterId       String?
  technicianId     String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  buildingId       String?
  attachments      Attachment[]
  buildingRef      Building?       @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  reporter         User?           @relation("ReporterTickets", fields: [reporterId], references: [id], onDelete: SetNull)
  technician       User?           @relation("TechnicianTickets", fields: [technicianId], references: [id], onDelete: SetNull)
  histories        TicketHistory[]

  @@index([status])
  @@index([priority])
  @@index([category])
  @@index([floor])
  @@index([roomName])
  @@index([building])
  @@index([buildingId])
  @@index([reporterId])
  @@index([technicianId])
}

model Attachment {
  id        String         @id @default(cuid())
  fileName  String
  fileSize  String?
  fileType  String?
  url       String
  type      AttachmentType @default(BEFORE)
  ticketId  String
  createdAt DateTime       @default(now())
  ticket    Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([type])
}

model TicketHistory {
  id          String       @id @default(cuid())
  status      TicketStatus
  step        Int?
  title       String?
  note        String?      @db.Text
  ticketId    String
  changedById String?
  timestamp   DateTime     @default(now())
  changedBy   User?        @relation("ChangedByUser", fields: [changedById], references: [id], onDelete: SetNull)
  ticket      Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([changedById])
}

model Building {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  zone        String
  totalFloors Int
  latitude    Float?
  longitude   Float?
  adminId     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  admin       User?    @relation("BuildingAdmin", fields: [adminId], references: [id], onDelete: SetNull)
  tickets     Ticket[]

  @@index([adminId])
  @@index([zone])
}

model DepartmentRoom {
  id          String   @id @default(cuid())
  code        String   @unique // เช่น "Lab101", "Lab301", "Room201"
  name        String   // เช่น "ห้องปฏิบัติการฮาร์ดแวร์และซ่อมบำรุงคอมพิวเตอร์ (Lab 101)"
  floor       Int      // 1-4
  type        String   @default("LAB") // LAB, CLASSROOM, OFFICE, RESTROOM, COMMON
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([floor])
  @@index([code])
}

enum Role {
  USER
  TECHNICIAN
  ADMIN
  SUPER_ADMIN
}

enum Category {
  PLUMBING         // ระบบประปา สุขภัณฑ์ และห้องน้ำ
  ELECTRICAL       // ระบบไฟฟ้า แสงสว่าง และปลั๊กไฟ
  AIR_CONDITIONING // ระบบเครื่องปรับอากาศ
  FURNITURE        // งานโครงสร้าง ครุภัณฑ์ และสถานที่
  PC_HARDWARE      // อุปกรณ์คอมพิวเตอร์และฮาร์ดแวร์ประจำแล็บ
  NETWORK          // ระบบเครือข่ายและอินเทอร์เน็ต
  AV_EQUIPMENT     // โสตทัศนูปกรณ์และสื่อการสอน
  IT_EQUIPMENT     // ไอทีและอุปกรณ์ทั่วไป (Legacy)
  OTHER            // อื่นๆ
}

enum Priority {
  LOW
  NORMAL
  URGENT
  CRITICAL
}

enum TicketStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  ON_HOLD
  RESOLVED
  CLOSED
  CANCELLED
}

enum AttachmentType {
  BEFORE
  AFTER
}
